@model IEnumerable<Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Autores</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo autor</a>
</div>

<partial name="_Buscador" model='"Buscar por nombre o nacionalidad"' />

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron autores.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Nacionalidad</th>
                    <th class="text-center">Libros en catálogo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var autor in Model)
                {
                    <tr>
                        <td>@autor.Nombre</td>
                        <td>@autor.Nacionalidad</td>
                        <td class="text-center">@autor.Libros.Count</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@autor.IdAutor">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@autor.IdAutor">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@autor.IdAutor">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Total: @Model.Count() autor(es).</p>
}
