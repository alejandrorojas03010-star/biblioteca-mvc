@model Autor
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.Nombre</h1>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.IdAutor">Editar</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Nº de autor</dt>
    <dd class="col-sm-9">@Model.IdAutor</dd>
    <dt class="col-sm-3">Nacionalidad</dt>
    <dd class="col-sm-9">@Model.Nacionalidad</dd>
</dl>

<h2 class="h5 mt-4">Libros en el catálogo</h2>
@if (!Model.Libros.Any())
{
    <p class="text-muted">Este autor todavía no tiene libros cargados.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var libro in Model.Libros.OrderBy(l => l.Titulo))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-controller="Libros" asp-action="Details" asp-route-id="@libro.IdLibro">@libro.Titulo</a>
                <span class="text-muted small">@libro.Genero · @libro.Stock disponible(s)</span>
            </li>
        }
    </ul>
}

<a asp-action="Index">Volver al listado</a>
