@model PrestamosPendientesViewModel
@{
    ViewData["Title"] = "Préstamos pendientes";
}

<h1 class="h3 mb-1">Reporte: préstamos pendientes</h1>
<p class="text-muted">Libros que todavía no fueron devueltos, del más antiguo al más reciente.</p>

<form method="get" class="card card-body mb-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="IdSocio" class="form-label"></label>
            <select asp-for="IdSocio" asp-items="Model.Socios" class="form-select">
                <option value="">Todos los socios</option>
            </select>
        </div>
        <div class="col-sm-6 col-md-2">
            <label asp-for="Desde" class="form-label"></label>
            <input asp-for="Desde" class="form-control" />
        </div>
        <div class="col-sm-6 col-md-2">
            <label asp-for="Hasta" class="form-label"></label>
            <input asp-for="Hasta" class="form-control" />
            <span asp-validation-for="Hasta" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 col-md-2">
            <label asp-for="DiasPermitidos" class="form-label"></label>
            <input asp-for="DiasPermitidos" class="form-control" min="1" max="365" />
            <span asp-validation-for="DiasPermitidos" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 col-md-2">
            <div class="form-check mb-2">
                <input asp-for="SoloAtrasados" class="form-check-input" />
                <label asp-for="SoloAtrasados" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Generar reporte</button>
        <a class="btn btn-link" asp-action="PrestamosPendientes">Quitar filtros</a>
    </div>
</form>

@if (ViewData.ModelState.IsValid)
{
    <div class="row g-3 mb-3">
        <div class="col-sm-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Préstamos pendientes</div>
                    <div class="fs-3 fw-semibold">@Model.CantidadPendientes</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Atrasados (más de @Model.DiasPermitidos días)</div>
                    <div class="fs-3 fw-semibold text-danger">@Model.CantidadAtrasados</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Promedio de días afuera</div>
                    <div class="fs-3 fw-semibold">@Model.PromedioDiasAfuera.ToString("0.#")</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Filas.Count == 0)
    {
        <div class="alert alert-info">No hay préstamos pendientes que coincidan con los filtros.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Socio</th>
                        <th>Email</th>
                        <th>Libro</th>
                        <th>Autor</th>
                        <th>Fecha de préstamo</th>
                        <th class="text-end">Días afuera</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr class="@(fila.EstaAtrasado ? "table-danger" : "")">
                            <td>@fila.Socio</td>
                            <td><a href="mailto:@fila.Email">@fila.Email</a></td>
                            <td>@fila.Libro</td>
                            <td>@fila.Autor</td>
                            <td>@fila.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@fila.DiasAfuera</td>
                            <td>
                                @if (fila.EstaAtrasado)
                                {
                                    <span class="badge text-bg-danger">Atrasado</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">En término</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-success" asp-controller="Prestamos" asp-action="Devolver" asp-route-id="@fila.IdPrestamo">Registrar devolución</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
