@model LibroFormViewModel
@{
    ViewData["Title"] = "Nuevo libro";
}

<h1 class="h3 mb-3">Nuevo libro</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <partial name="_Formulario" model="Model" />
            <button type="submit" class="btn btn-primary">Agregar al catálogo</button>
            <a class="btn btn-link" asp-action="Index">Volver al listado</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
