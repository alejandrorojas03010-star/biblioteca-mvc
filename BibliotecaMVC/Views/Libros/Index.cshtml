@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
    var hayFiltros = !string.IsNullOrEmpty(ViewData["Buscar"] as string) || !string.IsNullOrEmpty(ViewData["Genero"] as string);
    var generos = (SelectList)ViewData["Generos"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Catálogo de libros</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo libro</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-6 col-md-5">
        <input type="search" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por título o autor" aria-label="Buscar" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select name="genero" class="form-select" asp-items="generos" aria-label="Género">
            <option value="">Todos los géneros</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        @if (hayFiltros)
        {
            <a class="btn btn-link" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron libros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Género</th>
                    <th class="text-center">Stock disponible</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor!.Nombre</td>
                        <td>@libro.Genero</td>
                        <td class="text-center">
                            @if (libro.Stock == 0)
                            {
                                <span class="badge text-bg-danger">Sin stock</span>
                            }
                            else
                            {
                                @libro.Stock
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@libro.IdLibro">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@libro.IdLibro">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@libro.IdLibro">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Total: @Model.Count() título(s), @Model.Sum(l => l.Stock) ejemplar(es) disponibles.</p>
}
