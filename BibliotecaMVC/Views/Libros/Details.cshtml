@model Libro
@{
    ViewData["Title"] = Model.Titulo;
    var prestamos = Model.Prestamos.OrderByDescending(p => p.FechaPrestamo).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.Titulo</h1>
    <div>
        @if (Model.Stock > 0)
        {
            <a class="btn btn-primary" asp-controller="Prestamos" asp-action="Create" asp-route-idLibro="@Model.IdLibro">+ Prestar este libro</a>
        }
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.IdLibro">Editar</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9"><a asp-controller="Autores" asp-action="Details" asp-route-id="@Model.IdAutor">@Model.Autor!.Nombre</a></dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@Model.Genero</dd>
    <dt class="col-sm-3">Stock disponible</dt>
    <dd class="col-sm-9">@Model.Stock</dd>
    <dt class="col-sm-3">Prestados ahora</dt>
    <dd class="col-sm-9">@prestamos.Count(p => p.EstaPendiente)</dd>
</dl>

<h2 class="h5 mt-4">Historial de préstamos</h2>
@if (prestamos.Count == 0)
{
    <p class="text-muted">Este libro todavía no fue prestado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Socio</th>
                    <th>Fecha de préstamo</th>
                    <th>Fecha de devolución</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in prestamos)
                {
                    <tr>
                        <td>@prestamo.Socio!.Nombre</td>
                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                        <td>@(prestamo.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td><partial name="_EstadoPrestamo" model="prestamo" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index">Volver al listado</a>
