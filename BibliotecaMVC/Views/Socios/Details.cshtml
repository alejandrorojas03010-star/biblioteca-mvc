@model Socio
@{
    ViewData["Title"] = Model.Nombre;
    var prestamos = Model.Prestamos.OrderByDescending(p => p.FechaPrestamo).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.Nombre</h1>
    <div>
        <a class="btn btn-primary" asp-controller="Prestamos" asp-action="Create" asp-route-idSocio="@Model.IdSocio">+ Prestarle un libro</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.IdSocio">Editar</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Nº de socio</dt>
    <dd class="col-sm-9">@Model.IdSocio</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Fecha de alta</dt>
    <dd class="col-sm-9">@Model.FechaAlta.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Préstamos</dt>
    <dd class="col-sm-9">@prestamos.Count en total, @prestamos.Count(p => p.EstaPendiente) pendiente(s)</dd>
</dl>

<h2 class="h5 mt-4">Historial de préstamos</h2>
@if (prestamos.Count == 0)
{
    <p class="text-muted">Este socio todavía no retiró libros.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Libro</th>
                    <th>Fecha de préstamo</th>
                    <th>Fecha de devolución</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in prestamos)
                {
                    <tr>
                        <td>@prestamo.Libro!.Titulo</td>
                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                        <td>@(prestamo.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td><partial name="_EstadoPrestamo" model="prestamo" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index">Volver al listado</a>
