@model IEnumerable<Socio>
@{
    ViewData["Title"] = "Socios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Socios</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo socio</a>
</div>

<partial name="_Buscador" model='"Buscar por nombre o email"' />

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron socios.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Fecha de alta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var socio in Model)
                {
                    <tr>
                        <td>@socio.Nombre</td>
                        <td>@socio.Email</td>
                        <td>@socio.FechaAlta.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@socio.IdSocio">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@socio.IdSocio">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@socio.IdSocio">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Total: @Model.Count() socio(s).</p>
}
